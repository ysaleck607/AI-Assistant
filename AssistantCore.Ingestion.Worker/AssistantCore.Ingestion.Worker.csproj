<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AssistantCore.Ingestion.Worker</RootNamespace>
    <AssemblyName>AssistantCore.Ingestion.Worker</AssemblyName>
    <UserSecretsId>54151ca2-3e47-4ec9-bbdb-484b93dd3a6c</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AssistantCore.Repository\AssistantCore.Repository.csproj" />
    <ProjectReference Include="..\AssistantCore.Service\AssistantCore.Service.csproj" />
  </ItemGroup>

  <!--
    Both this project and AssistantCore.Service have their own appsettings*.json with
    the same file names but different content (Worker vs API config). MSBuild's default
    project-reference content propagation (GetCopyToOutputDirectoryItems) copies the
    referenced project's content items into this project's output too, silently
    overwriting this project's own appsettings*.json on every build - the Worker then
    fails startup options validation or runs unconfigured. ExcludeAssets on the
    ProjectReference does not stop this (that only controls NuGet-style restore assets,
    not this separate copy-to-output target), so this project's own appsettings*.json
    are explicitly re-copied last, after Build/Publish, guaranteeing they win regardless
    of copy order.
  -->
  <Target Name="RestoreOwnAppSettingsAfterBuild" AfterTargets="Build;Publish">
    <ItemGroup>
      <_WorkerOwnAppSettings Include="$(MSBuildProjectDirectory)\appsettings*.json" />
    </ItemGroup>
    <Copy
      SourceFiles="@(_WorkerOwnAppSettings)"
      DestinationFolder="$(OutDir)"
      SkipUnchangedFiles="false" />
  </Target>

</Project>
