    {
      "name": "Backoffice Microsoft 365",
      "item": [
        {
          "name": "Relancer l'indexation SharePoint",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const organizationId = pm.environment.get('backoffice_organization_id');",
                  "if (!organizationId || organizationId.startsWith('YOUR_')) {",
                  "    throw new Error('backoffice_organization_id must contain the client organization identifier.');",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 202', function () {",
                  "    pm.response.to.have.status(202);",
                  "});",
                  "pm.test('Returns a pending operation', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.status).to.eql('Pending');",
                  "    pm.expect(body.libraryCount).to.be.above(0);",
                  "    pm.environment.set('reindex_operation_id', body.operationId);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Reprise apres correction du connecteur\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/backoffice/organizations/{{backoffice_organization_id}}/microsoft365/reindex",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "backoffice",
                "organizations",
                "{{backoffice_organization_id}}",
                "microsoft365",
                "reindex"
              ]
            },
            "description": "Relance l'indexation complete des bibliotheques SharePoint activees du client. Reserve aux operateurs Synaptix (politique ManagementAdmin) : un administrateur du client recoit 403. Retourne 409 lorsqu'une reprise est deja en cours pour cette organisation. Le motif est facultatif."
          },
          "response": []
        },
        {
          "name": "Suivre une reindexation SharePoint",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const operationId = pm.environment.get('reindex_operation_id');",
                  "if (!operationId || operationId.startsWith('YOUR_')) {",
                  "    throw new Error('reindex_operation_id is set by the reindex request.');",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Reports progress without document content', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.have.property('completedLibraryCount');",
                  "    pm.expect(body).to.have.property('discoveredDocumentCount');",
                  "    pm.expect(body).to.have.property('requestedAt');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/backoffice/organizations/{{backoffice_organization_id}}/microsoft365/reindex/{{reindex_operation_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "backoffice",
                "organizations",
                "{{backoffice_organization_id}}",
                "microsoft365",
                "reindex",
                "{{reindex_operation_id}}"
              ]
            },
            "description": "Lit l'etat, les compteurs et les dates de la reprise. La reponse ne contient aucun contenu documentaire."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Conversations",
      "item": [
        {
          "name": "List Conversations",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response contains a conversations array', function () {",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.conversations).to.be.an('array');",
                  "});",
                  "",
                  "pm.test('Every summary carries its status and version', function () {",
                  "    const response = pm.response.json();",
                  "    response.conversations.forEach(function (conversation) {",
                  "        pm.expect(conversation.status).to.eql('Active');",
                  "        pm.expect(conversation.version).to.be.a('number');",
                  "    });",
                  "});",
                  "",
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    if (response.conversations.length > 0) {",
                  "        pm.environment.set('conversation_id', response.conversations[0].id);",
                  "        pm.environment.set('conversation_version', response.conversations[0].version);",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/conversations?limit=25",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "conversations"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "25"
                },
                {
                  "key": "cursor",
                  "value": "",
                  "disabled": true
                },
                {
                  "key": "status",
                  "value": "Active",
                  "disabled": true
                }
              ]
            },
            "description": "Retourne les conversations du membre connecte. Sans le parametre status, seules les conversations Active sont retournees. Chaque resume porte son status et sa version; le test enregistre ceux de la premiere conversation dans conversation_id et conversation_version pour alimenter Update Conversation.\n\nUne valeur de status inconnue retourne 400 avant toute lecture. Un curseur reste valide uniquement pour la valeur de status qui l'a produit."
          },
          "response": []
        },
        {
          "name": "List Archived Conversations",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Only archived conversations are returned', function () {",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.conversations).to.be.an('array');",
                  "    response.conversations.forEach(function (conversation) {",
                  "        pm.expect(conversation.status).to.eql('Archived');",
                  "    });",
                  "});",
                  "",
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    if (response.conversations.length > 0) {",
                  "        pm.environment.set('conversation_id', response.conversations[0].id);",
                  "        pm.environment.set('conversation_version', response.conversations[0].version);",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/conversations?status=Archived&limit=25",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "conversations"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "Archived"
                },
                {
                  "key": "limit",
                  "value": "25"
                }
              ]
            },
            "description": "Alimente la section Archives du frontend. Sans cet appel une conversation archivee deviendrait introuvable et ne pourrait plus etre restauree par Update Conversation avec le status Active.\n\nUne conversation supprimee logiquement n'apparait sous aucune valeur de status."
          },
          "response": []
        },
        {
          "name": "Update Conversation",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.environment.get('conversation_id')) {",
                  "    throw new Error('conversation_id is missing. Run Send Message or set conversation_id manually.');",
                  "}",
                  "",
                  "const version = pm.environment.get('conversation_version');",
                  "if (!version) {",
                  "    pm.request.headers.remove('If-Match');",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
